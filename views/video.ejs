<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.title %> - Gratis Erotik</title>
    <meta name="description" content="Titta på <%= video.title %> gratis på gratis-erotik.se.">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1 class="logo">GRATIS EROTIK</h1>
        <nav>
            <a href="/">Hem</a>
        </nav>
    </header>
    <main>
        <div class="video-container">
            <h2><%= video.title %></h2>
            <video controls width="100%">
                <source src="<%= video.url %>" type="video/mp4">
                Din webbläsare stöder inte videospelaren.
            </video>
        </div>
    </main>
</body>
</html>
