<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= video.title %> - <%= site.name %></title>
    <meta name="description" content="Titta på <%= video.title %> gratis på <%= site.domain %>.">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="site-theme-<%= site.theme || 'midnight' %>" style="--accent: <%= site.accent %>">
    <header>
        <div class="header-container">
            <h1 class="logo"><a href="/"><%= site.name %></a></h1>
            <nav aria-label="Huvudmeny">
                <a href="/"><i class="fas fa-home"></i> Hem</a>
                <a href="/#filmer"><i class="fas fa-play"></i> Filmer</a>
                <a href="/kategorier"><i class="fas fa-layer-group"></i> Kategorier</a>
                <a href="/lankar"><i class="fas fa-link"></i> Länkar</a>
            </nav>
        </div>
    </header>

    <%- include('partials/ad-top') %>

    <main>
        <div class="video-page-layout">
            <div class="main-player">
                <div class="embed-container">
                    <% if (video.embedUrl) { %>
                        <iframe src="<%= video.embedUrl %>" frameborder="0" allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
                    <% } else if (video.url.endsWith('.mp4')) { %>
                        <video controls width="100%" autoplay>
                            <source src="<%= video.url %>" type="video/mp4">
                            Din webbläsare stöder inte videospelaren.
                        </video>
                    <% } else { %>
                        <iframe src="<%= video.url %>" frameborder="0" allowfullscreen></iframe>
                    <% } %>
                </div>
                <div class="video-details">
                    <h1><%= video.title %></h1>
                    <div class="video-actions">
                        <% if (video.views != null) { %><span class="action-btn"><i class="fas fa-eye"></i> <%= video.views.toLocaleString('sv-SE') %> visningar</span><% } %>
                        <% if (video.rating != null) { %><span class="action-btn"><i class="fas fa-thumbs-up"></i> <%= video.rating.toLocaleString('sv-SE', { maximumFractionDigits: 1 }) %>%</span><% } %>
                        <% if (video.source === 'Pornhub') { %><a class="action-btn" href="<%= video.url %>" rel="noopener noreferrer" target="_blank">Visa hos Pornhub</a><% } %>
                    </div>
                    <% if (videoCategories.length) { %>
                        <div class="video-categories" aria-label="Filmens kategorier">
                            <% videoCategories.forEach(slug => { %><a class="category-chip" href="/?category=<%= slug %>#filmer"><%= slug.replace(/-/g, ' ') %></a><% }) %>
                        </div>
                    <% } %>
                </div>
            </div>

            <div class="related-videos">
                <h3>Liknande Filmer</h3>
                <div class="related-list">
                    <% related.forEach(rel => { %>
                        <a href="/video/<%= rel.id %>" class="related-item">
                            <img src="<%= rel.thumbnail %>" alt="<%= rel.title %>">
                            <p><%= rel.title %></p>
                        </a>
                    <% }) %>
                </div>
            </div>
        </div>
    </main>

    <%- include('partials/ad-bottom') %>

    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="/">Hem</a>
                <a href="/#filmer">Filmer</a>
                <a href="/kategorier">Kategorier</a>
                <a href="/lankar">Länkar</a>
            </div>
            <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>.</p>
        </div>
    </footer>
</body>
</html>
