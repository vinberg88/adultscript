<!DOCTYPE html>
<html lang="sv">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gratis Erotik - Filmer</title>
    <meta name="description" content="Se filmer på gratis-erotik.se.">
    <meta name="keywords" content="gratis erotik, porr, gratis filmer, erotiska klipp, gratis porr">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>
    <header>
        <div class="header-container">
            <h1 class="logo"><a href="/">GRATIS <span>EROTIK</span></a></h1>
            <nav aria-label="Huvudmeny">
                <a href="/"><i class="fas fa-home"></i> Hem</a>
                <a href="/#filmer"><i class="fas fa-play"></i> Filmer</a>
                <a href="/lankar"><i class="fas fa-link"></i> Länkar</a>
                <a href="/secret-admin-panel-777" rel="nofollow"><i class="fas fa-lock"></i> Admin</a>
            </nav>
        </div>
    </header>

    <div class="hero">
        <h2>Hitta dina favoritfilmer helt gratis</h2>
        <p>Senaste filmerna från våra källor.</p>
        <a class="hero-link" href="#filmer">Se filmerna</a>
    </div>

    <main id="filmer">
        <div class="category-bar" aria-label="Sortera filmer">
            <a class="cat-tag <%= sort === 'latest' ? 'active' : '' %>" href="/?sort=latest#filmer" <%- sort === 'latest' ? 'aria-current="page"' : '' %>>Senaste</a>
            <a class="cat-tag <%= sort === 'views' ? 'active' : '' %>" href="/?sort=views#filmer" <%- sort === 'views' ? 'aria-current="page"' : '' %>>Mest sedda</a>
            <a class="cat-tag <%= sort === 'rating' ? 'active' : '' %>" href="/?sort=rating#filmer" <%- sort === 'rating' ? 'aria-current="page"' : '' %>>Högst betyg</a>
        </div>

        <div class="video-grid">
            <% if (!videos.length) { %><p class="empty-state">Inga filmer finns att visa ännu.</p><% } %>
            <% videos.forEach(video => { %>
                <div class="video-card">
                    <a href="/video/<%= video.id %>">
                        <div class="thumb-container">
                            <img src="<%= video.thumbnail %>" alt="<%= video.title %>" loading="lazy">
                            <% if (video.duration) { %><div class="duration"><%= video.duration %></div><% } %>
                        </div>
                        <div class="card-info">
                            <p class="video-title"><%= video.title %></p>
                            <div class="card-stats">
                                <% if (video.rating != null) { %><span class="stat"><i class="fas fa-thumbs-up"></i> <%= video.rating %>%</span><% } %>
                                <% if (video.views != null) { %><span class="stat"><i class="fas fa-eye"></i> <%= video.views.toLocaleString('sv-SE') %></span><% } %>
                            </div>
                        </div>
                    </a>
                </div>
            <% }) %>
        </div>
    </main>

    <footer>
        <div class="footer-content">
            <div class="footer-links">
                <a href="/">Hem</a>
                <a href="/#filmer">Filmer</a>
                <a href="/lankar">Länkar</a>
                <a href="/secret-admin-panel-777" rel="nofollow">Admin</a>
            </div>
            <p>&copy; <%= new Date().getFullYear() %> Gratis Erotik.</p>
        </div>
    </footer>
</body>
</html>
