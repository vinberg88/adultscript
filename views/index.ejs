<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gratis Erotik - Bästa Gratis Filmerna</title>
    <meta name="description" content="Hitta de bästa gratis erotiska filmerna på gratis-erotik.se. Massor av innehåll helt gratis!">
    <meta name="keywords" content="gratis erotik, porr, gratis filmer, erotiska klipp">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header>
        <h1 class="logo">GRATIS EROTIK</h1>
        <nav>
            <a href="/">Hem</a>
        </nav>
    </header>
    <main>
        <div class="video-grid">
            <% videos.forEach(video => { %>
                <div class="video-card">
                    <a href="/video/<%= video.id %>">
                        <img src="<%= video.thumbnail %>" alt="<%= video.title %>">
                        <p><%= video.title %></p>
                    </a>
                </div>
            <% }) %>
        </div>
    </main>
    <footer>
        <div class="footer-links">
            <a href="#">Om oss</a>
            <a href="#">Kontakt</a>
            <a href="#">Villkor</a>
            <a href="#">Integritetspolicy</a>
            <a href="#">DMCA</a>
        </div>
        <p>&copy; 2024 Gratis Erotik - Alla rättigheter förbehållna.</p>
    </footer>
</body>
</html>
